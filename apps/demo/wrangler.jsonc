/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "autonomous-live-chat",
	"main": "src/entry.ts",
	"compatibility_date": "2026-08-05",
	"migrations": [
		{
			"new_sqlite_classes": [
				"ChatRoom"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"OsWorkspaceResponseTarget"
			],
			"tag": "v2"
		},
		{
			"deleted_classes": [
				"OsWorkspaceResponseTarget"
			],
			"tag": "v3"
		}
	],
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"services": [
		{
			"binding": "OPERATOR",
			"service": "app-harness-operator",
			"entrypoint": "OperatorGateway"
		},
		{
			// The sweep's merge-train reconciliation: one bounded candidate-PR
			// observation through the sole GitHub App capability when the stack
			// bottom's merged webhook never arrived.
			"binding": "GITHUB",
			"service": "app-harness-os-git-proxy",
			"entrypoint": "GitHubAppCapability"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ChatRoom",
				"name": "CHAT_ROOM"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"OPERATOR_PAUSED": "false"
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources such as KV, Durable Object, etc.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 * Bindings defined in wrangler.jsonc are exposed on the `env` parameter of the Worker handler.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * Environment variables are exposed on the `env` parameter of the Worker handler.
	 * https://developers.cloudflare.com/workers/configuration/environment-variables/
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/service-bindings/
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
