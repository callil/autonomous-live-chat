{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "es2022",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"allowJs": false,
		"checkJs": false,
		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"./worker-configuration.d.ts",
			"node"
		]
	},
	"include": ["src/**/*.ts", "src/modules.d.ts", "worker-configuration.d.ts"]
}
