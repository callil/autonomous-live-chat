/**
 * The FROZEN platform Worker: chat data plane, ledger, queue, feed, deploy
 * rails. Agent branches (room/*) can never touch this file — the platform
 * firewall workflow fails any such diff.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "app-harness-platform",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-05",
	"migrations": [
		{
			"new_sqlite_classes": [
				"RoomDO"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "RoomDO",
				"name": "ROOM_DO"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		// The room's daily spend ceiling, enforced at dispatch. The owner
		// bearer credential is a worker secret, never a var. GitHub App
		// credentials (GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID,
		// GITHUB_APP_PRIVATE_KEY), the webhook secret (GITHUB_WEBHOOK_SECRET),
		// and the Doctor's model credential (OPENAI_API_KEY — the same key the
		// platform runner rides; optional here, and without it the Doctor
		// degrades to the deterministic park-for-human stub) are worker
		// secrets too.
		"ROOM_DAILY_BUDGET_USD": "25",
		// The one repository this platform may read, merge, and deploy.
		"REPOSITORY": "callil/autonomous-live-chat",
		// The live PRODUCT worker origin (phase 3 product/platform split):
		// /version observation, liveness watchdog, and the feed link in
		// commit trailers. The legacy demo worker is not part of this loop.
		"PRODUCT_URL": "https://app-harness-product.coda-a.workers.dev"
	},
	"services": [
		{
			// Private RPC to the sandbox runner Worker (platform/runner).
			"binding": "RUNNER",
			"service": "app-harness-platform-runner",
			"entrypoint": "PlatformRunner"
		}
	],
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	]
}
