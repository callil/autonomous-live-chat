{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-harness-os-native-git",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_REPOSITORY": "callil/autonomous-live-chat",
    "NATIVE_GIT_ENABLED": "true",
    "SANDBOX_CLOUDFLARE_ACCOUNT_ID": "8942a6623f97627c7c62b64b259e5585"
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" }
    ]
  },
  "services": [
    {
      "binding": "GITHUB_APP",
      "service": "app-harness-os-git-proxy",
      "entrypoint": "GitHubAppCapability"
    }
  ],
  "migrations": [
    { "new_sqlite_classes": ["Sandbox"], "tag": "v1" },
    { "new_sqlite_classes": ["RunnerJob"], "tag": "v2" },
    { "deleted_classes": ["RunnerJob"], "tag": "v3" }
  ]
}
